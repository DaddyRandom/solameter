# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Monitoring interval in milliseconds (default: 60000 = 1 minute)
MONITOR_INTERVAL=60000

# Funding rate thresholds (in basis points, 100 = 1%)
# Negative funding threshold (shorts pay longs)
NEGATIVE_FUNDING_THRESHOLD=-10

# Positive funding threshold (longs pay shorts)
POSITIVE_FUNDING_THRESHOLD=10

# Alert mode: console, webhook, both
ALERT_MODE=console

# Optional: Webhook URL for alerts
# WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url
